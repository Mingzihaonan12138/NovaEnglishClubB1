rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isV1Admin() {
      // In this simple app, we treat the teacher as admin
      return isSignedIn() && (request.auth.token.email.lower() == 'xuanyu.diao@gmail.com' || request.auth.token.email.lower() == 'aitonghan02@gmail.com');
    }

    // Audio no longer lives on this document (see /recordingAudio), so audioUrl
    // is optional — legacy documents from the Firebase Storage era still have it.
    function isValidRecording(data) {
      return data.keys().hasAll(['studentId', 'questionId', 'createdAt', 'status']) &&
             data.studentId is string &&
             data.questionId is string &&
             (!data.keys().hasAny(['audioUrl']) || (data.audioUrl is string && data.audioUrl.size() < 2048)) &&
             data.status in ['pending', 'reviewed'];
    }

    // --- Access control -----------------------------------------------------
    // Signing in is open: anyone with a Google account may create their own
    // profile and try the app. That is the top of the funnel, and it is what
    // lets the teacher see who turned up before deciding to take them on.
    //
    // Being ENROLLED is a separate, teacher-granted step. The teacher writes
    // /allowlist/<lowercased email>, and only then may the account submit
    // recordings or accumulate progress. Everything an anonymous visitor can do
    // is read-only, because writes are what consume the project's quota — a
    // single recording is up to 1 MB and the free tier holds about 5,800 of
    // them, so an open write path would be the one thing worth abusing.
    // The teacher counts as enrolled without being on their own roster,
    // otherwise they cannot record anything to check that submitting works.
    function isEnrolled() {
      return isV1Admin() ||
             (isSignedIn() &&
              request.auth.token.email != null &&
              exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower())));
    }

    function isValidRecordingAudio(data) {
      return data.keys().hasAll(['studentId', 'audioBase64', 'mimeType']) &&
             data.studentId is string &&
             data.audioBase64 is string &&
             data.audioBase64.size() <= 700000 &&
             data.mimeType is string;
    }

    function isValidListeningMark(data) {
      return data.keys().hasAll(['userId', 'studentEmail', 'questionId', 'topic', 'marked']) &&
             data.userId is string &&
             data.studentEmail is string &&
             data.questionId is string &&
             data.topic is string &&
             data.marked is bool;
    }

    // The roster of enrolled students. A visitor may check their own entry so
    // the app can tell them whether the teacher has taken them on yet; only the
    // teacher may read the whole list or change it.
    match /allowlist/{email} {
      allow get: if isV1Admin() ||
                    (isSignedIn() && request.auth.token.email != null &&
                     request.auth.token.email.lower() == email);
      allow list: if isV1Admin();
      allow write: if isV1Admin();
    }

    // The audio for one recording, kept out of /recordings so that listing
    // submissions stays cheap. Immutable once written: a student may create and
    // delete their own, but not rewrite someone else's.
    match /recordingAudio/{recordingId} {
      allow create: if isEnrolled() && isValidRecordingAudio(request.resource.data)
                    && request.resource.data.studentId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isV1Admin());
      allow delete: if isV1Admin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }

    match /recordings/{recordingId} {
      allow create: if isEnrolled() && isValidRecording(request.resource.data) && request.resource.data.studentId == request.auth.uid;
      allow read: if isOwner(resource.data.studentId) || isV1Admin();
      allow update: if isV1Admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherFeedback', 'status', 'studentId', 'oldStudentId', 'updatedAt', 'audioBase64', 'hasAudio']);
      allow delete: if isV1Admin();
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isV1Admin());
    }

    match /userTopics/{topicId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isV1Admin());
      allow write: if isV1Admin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isV1Admin());
    }

    match /userConversations/{convId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isV1Admin());
      allow write: if isV1Admin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isV1Admin());
    }

    match /globalTopics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isV1Admin();
    }

    match /listeningMetadata/{questionId} {
      allow read: if isSignedIn();
      allow write: if isV1Admin();
    }

    // Shared listening bank. Nothing here is personal, so every enrolled
    // student may read it; only the teacher writes it.
    match /listeningQuestions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isV1Admin();
    }

    // Which of those a given student may practise. Deliberately NOT a field on
    // users/{uid}, because students can write their own user document and would
    // then be able to assign themselves material.
    match /listeningAssignments/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isV1Admin());
      allow write: if isV1Admin();
      allow list: if isV1Admin();
    }

    match /listeningProgress/{progressId} {
      allow create: if isEnrolled() && request.resource.data.studentId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isV1Admin());
      allow update: if isSignedIn() && request.resource.data.studentId == request.auth.uid && resource.data.studentId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || isV1Admin());
    }

    match /listeningMarked/{markedId} {
      allow create: if isEnrolled() && isValidListeningMark(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isV1Admin());
      allow update: if isSignedIn() && isValidListeningMark(request.resource.data) && request.resource.data.userId == request.auth.uid && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isV1Admin());
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isV1Admin());
      // Open on purpose: a profile is how the teacher discovers that someone
      // turned up. It grants nothing on its own — submitting work requires
      // being on the allowlist.
      allow create, update, delete: if isV1Admin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isV1Admin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isV1Admin();
    }
  }
}
